<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MyApplication.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#D9DCE5</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:statusBarColor">#D9DCE5</item>
        <item name="android:navigationBarColor">#D9DCE5</item>
        <item name="android:windowBackground">#D9DCE5</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
