<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="#2A2E38">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KESTREL"
            android:textColor="#A7B0C4"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />
        <TextView
            android:id="@+id/kc_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="#454B5C"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="Today"
            android:textColor="#D9DCE5"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/kc_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Your health looks solid today"
        android:textColor="#D9DCE5"
        android:textSize="16sp"
        android:textStyle="bold"
        android:maxLines="2" />

    <TextView
        android:id="@+id/kc_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Keep the streak going."
        android:textColor="#A7B0C4"
        android:textSize="13sp"
        android:maxLines="4" />

    <LinearLayout
        android:id="@+id/kc_progress_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/kc_progress_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Plan 0%"
            android:textColor="#A7B0C4"
            android:textSize="11sp"
            android:textStyle="bold" />
        <!-- Progress as text bar using blocks for RemoteViews compatibility -->
        <TextView
            android:id="@+id/kc_progress_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="░░░░░░░░░░"
            android:textColor="#D9DCE5"
            android:textSize="12sp"
            android:letterSpacing="0.08" />
    </LinearLayout>
</LinearLayout>
