<?xml version="1.0" encoding="utf-8"?>
<!-- Shown on lock screen + shade while a run is active -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#2A2E38">

    <TextView
        android:id="@+id/nr_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Run"
        android:textColor="#A7B0C4"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/nr_distance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0.00"
            android:textColor="#D9DCE5"
            android:textSize="28sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/nr_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="#D9DCE5"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingStart="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/nr_pace"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="— /km"
            android:textColor="#A7B0C4"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/nr_hr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#A7B0C4"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
