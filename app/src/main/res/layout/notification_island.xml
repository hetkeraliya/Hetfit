<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded notch / Dynamic Island / lock-screen live run card for Essentials & similar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="#1C1C1E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/ni_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="RUN"
            android:textColor="#8E8E93"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/ni_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="#F5F5F7"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/ni_distance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0.00 km"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/ni_pace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="— /km"
            android:textColor="#AEAEB2"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical">

        <!-- HR zone dot (color set from code) -->
        <TextView
            android:id="@+id/ni_hr_dot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:text="●"
            android:textColor="#34C759"
            android:textSize="12sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/ni_hr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="— bpm"
            android:textColor="#34C759"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ni_hr_zone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#8E8E93"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
