<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#7A3B5F8F" android:endColor="#8C0B1A33" />
            <corners android:radius="26dp" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
            <padding android:left="14dp" android:top="14dp" android:right="14dp" android:bottom="14dp" />
        </shape>
    </item>
    <item android:top="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#33FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="25dp" android:topRightRadius="25dp" android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
            <size android:height="40dp" />
        </shape>
    </item>
</layer-list>
